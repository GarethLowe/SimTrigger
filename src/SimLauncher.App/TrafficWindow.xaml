<Window x:Class="SimLauncher.App.TrafficWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SimLauncher.App.ViewModels"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:TrafficViewModel}"
        Title="Traffic Monitor" Width="1180" Height="760"
        Icon="/Assets/app.ico"
        Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Status bar -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" Padding="12,7">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,1,7,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#F08080" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LinkConnected}" Value="True">
                                    <Setter Property="Fill" Value="#7BC97F" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding LinkStatusText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SimTimeText}" Margin="24,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource CountdownBrush}" />
                <TextBlock Text="{Binding RouteText}" Margin="24,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource DimBrush}" />
                <TextBlock Text="{Binding CountText}" Margin="24,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource DimBrush}" />
                <CheckBox Content="Trails" Margin="24,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding TrailsEnabled}" />
                <CheckBox Content="Data labels" Margin="12,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding LabelsEnabled}" />
                <Button Content="Recenter" Margin="16,0,0,0" Padding="8,2" FontSize="11"
                        Command="{Binding RecenterCommand}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <wv2:WebView2 x:Name="MapView" Grid.Column="0" DefaultBackgroundColor="#1E1E1E" />

            <!-- Side panel -->
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Conflicts" FontSize="13" FontWeight="SemiBold" Margin="2,0,0,6" />

                    <ListBox Grid.Row="1" ItemsSource="{Binding Conflicts}" Background="#1B1B1C"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ConflictRowViewModel}">
                                <Border CornerRadius="4" Padding="8,6" Margin="0,2" BorderThickness="1">
                                    <Border.Style>
                                        <!-- Red/yellow = player involved; blues = AI-vs-AI. Default is AI caution. -->
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#263140" />
                                            <Setter Property="BorderBrush" Value="#46618A" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsConflict}" Value="True" />
                                                        <Condition Binding="{Binding InvolvesPlayer}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Background" Value="#24344E" />
                                                    <Setter Property="BorderBrush" Value="#5080B0" />
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsConflict}" Value="False" />
                                                        <Condition Binding="{Binding InvolvesPlayer}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Background" Value="#3A3A22" />
                                                    <Setter Property="BorderBrush" Value="#8A8A4A" />
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsConflict}" Value="True" />
                                                        <Condition Binding="{Binding InvolvesPlayer}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Background" Value="#4A2626" />
                                                    <Setter Property="BorderBrush" Value="#A05050" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding SeverityText}" FontSize="10" FontWeight="Bold"
                                                       VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter Property="Foreground" Value="#7FA6D9" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsConflict}" Value="True" />
                                                                    <Condition Binding="{Binding InvolvesPlayer}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Foreground" Value="#7FB2FF" />
                                                            </MultiDataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsConflict}" Value="False" />
                                                                    <Condition Binding="{Binding InvolvesPlayer}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Foreground" Value="{StaticResource CountdownBrush}" />
                                                            </MultiDataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsConflict}" Value="True" />
                                                                    <Condition Binding="{Binding InvolvesPlayer}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Foreground" Value="{StaticResource FailedTextBrush}" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding PairText}" FontWeight="SemiBold" />
                                            <TextBlock Text=" · you" Foreground="{StaticResource AccentBrush}" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding InvolvesPlayer, Converter={x:Static vm:Converters.BoolToVisible}}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding DetailText}" FontSize="11"
                                                   Foreground="{StaticResource DimBrush}" Margin="0,2,0,0" />
                                        <Button Content="{Binding RemoveText}" Command="{Binding RemoveCommand}"
                                                HorizontalAlignment="Left" FontSize="11" Padding="8,2" Margin="0,5,0,0"
                                                Visibility="{Binding CanRemove, Converter={x:Static vm:Converters.BoolToVisible}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Cull + threshold settings -->
                    <Expander Grid.Row="2" Header="Settings" Margin="0,8,0,0" IsExpanded="False">
                        <StackPanel Margin="2,6,2,0">
                            <TextBlock Text="Conflict pairs" FontSize="11"
                                       Foreground="{StaticResource DimBrush}" Margin="0,0,0,2" />
                            <ComboBox ItemsSource="{Binding ConflictScopeOptions}"
                                      SelectedItem="{Binding SelectedConflictScope}"
                                      Margin="0,0,0,8" />
                            <CheckBox Content="Auto-cull conflicting AI aircraft" IsChecked="{Binding AutoCull}" />
                            <CheckBox Content="Dry-run (log only, don't remove)" IsChecked="{Binding DryRun}"
                                      Margin="0,4,0,8" />
                            <UniformGrid Columns="2" Rows="4">
                                <TextBlock Text="Conflict horizontal (nm)" FontSize="11"
                                           Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" />
                                <TextBox Text="{Binding ConflictHNm, UpdateSourceTrigger=PropertyChanged}" Margin="0,1" />
                                <TextBlock Text="Conflict vertical (ft)" FontSize="11"
                                           Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" />
                                <TextBox Text="{Binding ConflictVFt, UpdateSourceTrigger=PropertyChanged}" Margin="0,1" />
                                <TextBlock Text="Caution horizontal (nm)" FontSize="11"
                                           Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" />
                                <TextBox Text="{Binding CautionHNm, UpdateSourceTrigger=PropertyChanged}" Margin="0,1" />
                                <TextBlock Text="Caution vertical (ft)" FontSize="11"
                                           Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" />
                                <TextBox Text="{Binding CautionVFt, UpdateSourceTrigger=PropertyChanged}" Margin="0,1" />
                            </UniformGrid>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Apply thresholds" Command="{Binding ApplyThresholdsCommand}"
                                        FontSize="11" Padding="8,3" />
                                <TextBlock Text="{Binding ThresholdStatus}" FontSize="11" Margin="10,0,0,0"
                                           VerticalAlignment="Center" Foreground="{StaticResource DimBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <TextBlock Grid.Row="3" Text="Action log" FontSize="13" FontWeight="SemiBold" Margin="2,10,0,6" />

                    <ListBox Grid.Row="4" ItemsSource="{Binding ActionLog}" x:Name="ActionLogList"
                             HorizontalContentAlignment="Stretch" SelectionMode="Extended"
                             KeyDown="OnActionLogKeyDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ActionLogRowViewModel}">
                                <Grid Margin="0,2">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Copy line" Command="{Binding CopyCommand}" />
                                            <MenuItem Header="Copy selected" Click="OnCopySelectedLog" />
                                            <MenuItem Header="Copy all" Click="OnCopyAllLog" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding TimeText}"
                                               FontFamily="Consolas" FontSize="11" Margin="0,1,6,0"
                                               Foreground="{StaticResource DimBrush}" VerticalAlignment="Top" />
                                    <Border Grid.Row="0" Grid.Column="1" CornerRadius="3" Padding="0,1"
                                            Background="{Binding KindBackground}" Margin="0,0,6,0"
                                            VerticalAlignment="Top" HorizontalAlignment="Stretch">
                                        <TextBlock Text="{Binding KindText}" FontSize="9" FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{Binding KindForeground}" />
                                    </Border>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Text}"
                                               FontSize="11" TextWrapping="Wrap" />
                                    <Expander Grid.Row="1" Grid.Column="2" FontSize="10" Margin="0,2,0,0"
                                              Foreground="{StaticResource DimBrush}"
                                              Visibility="{Binding HasDetail, Converter={x:Static vm:Converters.BoolToVisible}}">
                                        <Expander.Header>
                                            <TextBlock Text="payload" FontSize="10"
                                                       Foreground="{StaticResource DimBrush}" />
                                        </Expander.Header>
                                        <Border Background="#1B1B1C" CornerRadius="3" Padding="6" Margin="0,2,0,0">
                                            <TextBox Text="{Binding Detail, Mode=OneWay}" IsReadOnly="True"
                                                     FontFamily="Consolas" FontSize="10" BorderThickness="0"
                                                     TextWrapping="Wrap" MaxHeight="140"
                                                     VerticalScrollBarVisibility="Auto" />
                                        </Border>
                                    </Expander>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
