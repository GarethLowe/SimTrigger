<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\SimConnectSdk.props" />

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants Condition="'$(SimConnectAvailable)' == 'true'">$(DefineConstants);SIMCONNECT_SDK</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <ProjectReference Include="..\SimLauncher.Core\SimLauncher.Core.csproj" />
  </ItemGroup>

  <Target Name="WarnNoSimConnect" BeforeTargets="CoreCompile" Condition="'$(SimConnectAvailable)' != 'true'">
    <Warning Text="MSFS SDK not found (MSFS_SDK / MSFS2024_SDK not set or SimConnect DLL missing). Building SimConnect STUB — sim state detection will be disabled at runtime. See README." />
  </Target>
</Project>
